# Copy this file to .env.local and replace every placeholder.
# Use a unique random secret (32+ characters) and never commit .env.local.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
AUTH_EMAIL=customer@example.com
AUTH_PASSWORD=change-this-customer-password
STAFF_EMAIL=staff@example.com
STAFF_PASSWORD=change-this-staff-password
KITCHEN_EMAIL=kitchen@example.com
KITCHEN_PASSWORD=change-this-kitchen-password
# Set the actual deployed origin before deploying; localhost is fine for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
